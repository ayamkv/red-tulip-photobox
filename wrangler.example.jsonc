{
	"name": "red-tulip-photobox",
	"compatibility_date": "2026-06-12",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "red-tulip-photobox",
			"database_id": "PASTE_D1_DATABASE_ID_HERE"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "red-tulip-photobox"
		}
	]
}
